__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
*.sqlite3
*.sqlite3-journal
media/
staticfiles/

# Node, Vite y resultados generados
node_modules/
dist/
build/
.vite/
coverage/
*.tsbuildinfo
